{
  "name": "dsh-workspace-only-plugin",
  "version": "0.2.1",
  "description": "Workspace Only switch for DeepSeek Harness: confine file access of every sandbox mode to the session workspace, with a three-choice gate, an always-whitelist, and per-session bypass",
  "type": "module",
  "main": "./lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "scripts",
    "install.sh",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "scripts": {
    "verify-scanner": "node scripts/verify-scanner.mjs",
    "check-compat": "node scripts/check-compat.mjs"
  }
}
