{
  "name": "dsh-workspace-only-plugin",
  "version": "0.2.2",
  "description": "Workspace Only switch for DeepSeek Harness: confine file access of every sandbox mode to the session workspace, with a three-choice gate, an always-whitelist, and per-session bypass",
  "type": "module",
  "main": "./lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "scripts",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "scripts": {
    "verify-scanner": "node scripts/verify-scanner.mjs",
    "check-compat": "node scripts/check-compat.mjs",
    "build": "vite build -c vite.host.config.mjs && vite build -c vite.client.config.mjs",
    "prepack": "pnpm build"
  },
  "packageManager": "pnpm@12.3.4",
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "react": "^19",
    "vite": "^7"
  }
}
