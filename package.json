{
  "name": "dsh-workspace-only-plugin",
  "version": "0.3.0",
  "description": "Workspace Only switch for DeepSeek Harness: confine file access of every sandbox mode to the session workspace, with a three-choice gate, an always-whitelist, and per-session bypass",
  "type": "module",
  "main": "./lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "vendor",
    "migrations",
    "cordis.patch.yml",
    "README.md",
    "scripts",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "scripts": {
    "test": "node --test \"tests/*.test.ts\"",
    "verify-scanner": "node scripts/verify-scanner.ts",
    "verify-allow-command": "node scripts/verify-allow-command.ts",
    "check-compat": "node scripts/check-compat.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build -c vite.host.config.ts && vite build -c vite.client.config.ts",
    "prepack": "pnpm build"
  },
  "packageManager": "pnpm@12.3.4",
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.5",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session": "0.2.1-rc.5",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "^22",
    "@types/react": "^19",
    "react": "^19",
    "typescript": "^5",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@lumis-sh/wasm-bash": "^0.26.7",
    "@lumis-sh/wasm-powershell": "^0.26.6",
    "@wuyuchentr/database-migration-tool": "1.0.0",
    "drizzle-orm": "1.0.0-rc.5",
    "web-tree-sitter": "^0.27.1"
  }
}
